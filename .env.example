# Copy to server/.env and fill in. NEVER commit the real .env file.

# --- Server ---
PORT=3000
# production makes a too-short JWT_SECRET a startup error
NODE_ENV=development
# Set to 1 when behind one reverse proxy (Render, Railway, Nginx...) so rate limiting sees real client IPs
TRUST_PROXY=
# Failed admin logins allowed per IP per 15 minutes (default 5)
LOGIN_MAX_ATTEMPTS=5
# Requests per IP per minute across the whole API (default 300)
API_RATE_LIMIT=300
# Comma-separated list of allowed frontend origins (your deployed site + local dev)
CLIENT_ORIGIN=http://localhost:5173

# --- MongoDB Atlas ---
# Atlas > Connect > Drivers. URL-encode special characters in the password.
# Atlas > Network Access must allow the IP of the machine/host running the API.
MONGODB_URI=mongodb://portfolio_admin:Arfan4450320@cluster0.mjeytle.mongodb.net/portfolio?retryWrites=true&w=majority
# Database name used when the URI does not contain one
MONGODB_DB_NAME=portfolio

# --- Admin auth ---
ADMIN_USERNAME=admin
# Use EITHER a bcrypt hash (recommended) or a plain password.
# Generate a hash:  node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
ADMIN_PASSWORD_HASH=$2b$12$SR82zoaqJrvbE2MAQuaZnOre4qjPJk5e2Lt53BgdmSDAFYaFeAeGO
ADMIN_PASSWORD=
# Long random string, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=85b9395b042f9388377b55c4745d0cbe5c7e11b79209dfe63b294607dac6012b326b15f581efde2e4369a6fa909b7a3d

# --- Cloudinary (image uploads). Keep the API secret on the server only. ---
CLOUDINARY_CLOUD_NAME=js3zvo12
CLOUDINARY_API_KEY=679896928779479
CLOUDINARY_API_SECRET=a6HzNGCGr7OFcLP3wCr-FWfPks8
# Unreferenced images older than this are deleted by the periodic cleanup (default 60)
CLOUDINARY_ORPHAN_GRACE_MINUTES=60
# Set to off to disable the periodic orphan cleanup
CLOUDINARY_CLEANUP=on

#emailjs
VITE_EMAILJS_SERVICE_ID=service_csy6jfo
VITE_EMAILJS_TEMPLATE_ID=template_vdcwusk
VITE_EMAILJS_PUBLIC_KEY=cFBbuEe0kfdBMfDkE

# --- Legacy SMTP contact endpoint (optional; the site now uses EmailJS from the browser) ---
