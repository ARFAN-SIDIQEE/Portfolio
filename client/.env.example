# Copy to client/.env. These VITE_ values are bundled into the public site,
# so only put public values here (never secrets).

# Leave empty in local dev (Vite proxies /api). Set to your deployed API, e.g. https://api.example.com/api
VITE_API_URL=

# EmailJS (https://dashboard.emailjs.com). Template variables: {{from_name}}, {{from_email}}, {{message}}

VITE_EMAILJS_SERVICE_ID=service_csy6jfo
VITE_EMAILJS_TEMPLATE_ID=template_vdcwusk
VITE_EMAILJS_PUBLIC_KEY=cFBbuEe0kfdBMfDk
